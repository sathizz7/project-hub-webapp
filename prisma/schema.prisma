generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  role         String
  email        String   @unique
  avatarColor  String   @default("#3b82f6")
  passwordHash String?
  roleType     String   @default("team_member") // "ceo" | "team_member"
  createdAt    DateTime @default(now())

  assignedProjects     ProjectAssignee[]
  submissions          Submission[]
  feedback             Feedback[]
  tasksAssigned        Task[]                @relation("TaskAssignee")
  leavesRequested      LeaveRequest[]        @relation("LeaveRequester")
  leavesApproved       LeaveRequest[]        @relation("LeaveApprover")
  leavesCovered        LeaveRequest[]        @relation("LeaveCoverPerson")
  extensionRequests    DeadlineExtension[]   @relation("ExtensionRequester")
  extensionsApproved   DeadlineExtension[]   @relation("ExtensionApprover")
  captureSessions      CaptureSession[]
  captureItemsAssigned CaptureItemAssignee[] @relation("CaptureAssignee")

  @@map("users")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  type         String   // "engineering" or "research"
  requirement  String
  status       String   @default("active") // active, completed, killed
  priority     String   @default("medium") // low, medium, high, critical
  currentPhase String   @default("")
  timeboxDays  Int      @default(14)
  startDate    DateTime @default(now())
  techStack    String   @default("[]") // JSON string
  aiPlan       String   @default("{}") // JSON string
  createdAt    DateTime @default(now())

  assignees   ProjectAssignee[]
  phases      Phase[]
  submissions Submission[]
  checkpoints Checkpoint[]
  tasks       Task[]
  extensions  DeadlineExtension[]

  @@map("projects")
}

model ProjectAssignee {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignees")
}

model Phase {
  id        String @id @default(cuid())
  projectId String
  phaseName String
  status    String @default("pending") // pending, active, completed
  checklist String @default("[]") // JSON string array of checklist items
  order     Int

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions Submission[]
  tasks       Task[]

  @@map("phases")
}

model Submission {
  id          String   @id @default(cuid())
  phaseId     String
  projectId   String
  userId      String
  title       String
  type        String   // document, code, architecture, notebook, demo
  description String
  link        String   @default("")
  createdAt   DateTime @default(now())

  phase    Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback Feedback[]

  @@map("submissions")
}

model Feedback {
  id           String   @id @default(cuid())
  submissionId String
  fromUserId   String
  text         String
  isAi         Boolean  @default(false)
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromUser   User       @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Checkpoint {
  id        String   @id @default(cuid())
  projectId String
  decision  String   // "continue" or "kill"
  notes     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("checkpoints")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  projectId   String
  phaseId     String?
  assigneeId  String?
  dueDate     DateTime?
  priority    String    @default("medium") // low | medium | high | critical
  status      String    @default("planning") // planning | in_progress | blocked | completed | killed
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase      Phase?              @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee   User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  extensions DeadlineExtension[]

  @@index([assigneeId])
  @@index([projectId])
  @@map("tasks")
}

model LeaveRequest {
  id              String    @id @default(cuid())
  userId          String
  type            String    // planned | sick | personal | wfh | half_day
  startDate       DateTime
  endDate         DateTime
  days            Float
  reason          String    @default("")
  status          String    @default("pending") // pending | approved | rejected
  approvedById    String?
  approvedAt      DateTime?
  coveragePlan    String    @default("")
  coverPersonId   String?
  contingencyNote String    @default("")
  createdAt       DateTime  @default(now())

  user        User  @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  coverPerson User? @relation("LeaveCoverPerson", fields: [coverPersonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model DeadlineExtension {
  id                String    @id @default(cuid())
  projectId         String
  taskId            String?
  requestedById     String
  originalDeadline  DateTime
  requestedDeadline DateTime
  reason            String    // delay reason category
  reasonDetail      String    @default("")
  status            String    @default("pending") // pending | approved | rejected | auto_escalated
  ceoComment        String    @default("")
  approvedById      String?
  approvedAt        DateTime?
  escalationLevel   Int       @default(0)
  createdAt         DateTime  @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  requestedBy User    @relation("ExtensionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy  User?   @relation("ExtensionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([projectId])
  @@map("deadline_extensions")
}

model CaptureSession {
  id        String        @id @default(cuid())
  userId    String
  rawInput  String
  createdAt DateTime      @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CaptureItem[]

  @@index([userId])
  @@map("capture_sessions")
}

model CaptureItem {
  id              String    @id @default(cuid())
  sessionId       String
  type            String    // todo | follow_up | commitment | meeting | review | timeline
  rawText         String
  title           String
  description     String    @default("")
  department      String    @default("")
  dueDate         DateTime?
  priority        String    @default("medium")
  status          String    @default("pending") // pending | converted | dismissed
  projectId       String?
  convertedToType String?
  convertedToId   String?
  createdAt       DateTime  @default(now())

  session   CaptureSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignees CaptureItemAssignee[]

  @@index([sessionId])
  @@index([status])
  @@map("capture_items")
}

model CaptureItemAssignee {
  itemId String
  userId String

  item CaptureItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation("CaptureAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
  @@map("capture_item_assignees")
}
